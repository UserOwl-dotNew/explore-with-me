        {
          "name": "Пагинация работает корректно",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Код статуса ответа 200\", function() {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Ответ - массив\", function() {\r",
                  "    pm.expect(pm.response.json()).to.be.an('array');\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Количество элементов в массиве 2 или меньше\", function() {\r",
                  "    pm.expect(pm.response.json().length).to.be.at.most(2);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Элементы отсортированы по дате\", function() {\r",
                  "    const comments = pm.response.json();\r",
                  "    if (comments.length > 1) {\r",
                  "        const firstDate = new Date(comments[0].createdAt);\r",
                  "        const secondDate = new Date(comments[1].createdAt);\r",
                  "        pm.expect(firstDate.getTime()).to.be.at.least(secondDate.getTime());\r",
                  "    }\r",
                  "})"
                ],
